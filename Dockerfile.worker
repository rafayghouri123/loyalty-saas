FROM node:24.21.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.worker.json ./
COPY src ./src
RUN ./node_modules/.bin/tsc -p tsconfig.worker.json
RUN npm prune --omit=dev

FROM node:24.21.0-bookworm-slim
ENV NODE_ENV=production APP_ENV=staging
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist/worker ./dist/worker
COPY --chown=node:node package.json ./
COPY --chown=node:node scripts/worker-health.mjs ./scripts/worker-health.mjs
COPY --chown=node:node scripts/monitor-worker.mjs ./scripts/monitor-worker.mjs
COPY --chown=node:node scripts/monitor-delivery.mjs ./scripts/monitor-delivery.mjs
USER node
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD ["node","scripts/worker-health.mjs"]
CMD ["node","dist/worker/worker/main.js"]
