# Copy to .env.local. Do not commit credentials. Missing providers disable dependent actions.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# After configuring the deployed origin, run setup:whatsapp-origin with operator credentials.
# Manual public-offer links use that private canonical value, never a browser-supplied origin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set real product identity/support and published policies before live enrollment.
PRODUCT_NAME=
SUPPORT_EMAIL=
# Worker uses a dedicated login role, never the migration role.
WORKER_DATABASE_URL=
WORKER_DB_SSL=true
DATABASE_CA_CERT_PATH=
# Hosted alternatives to a filesystem path; configure only one certificate source.
DATABASE_CA_CERT_PEM=
DATABASE_CA_CERT_BASE64=
# Operator-only isolated project setup; never use this credential in app/worker runtime.
MIGRATION_DATABASE_URL=
WEB_GATEWAY_DATABASE_URL=
WEB_GATEWAY_DB_SSL=true
PUSH_REGISTRATION_ENABLED=false
LIVE_PUSH_ENABLED=false
# Storage service key: worker and guarded private-proof web proxy only.
# Browser uploads use the authenticated user's exact-path grant.
MEDIA_PROCESSING_ENABLED=false
STORAGE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# setup:keys creates local-only keys; production uses secret stores and explicit IDs.
ENCRYPTION_KEY_ID=
ENCRYPTION_KEY_BASE64=
RATE_LIMIT_HMAC_KEY_BASE64=

# Enable only after real sender delivery and direct Supabase Auth bypass controls are verified.
EMAIL_LOGIN_ENABLED=false
EMAIL_DIRECT_AUTH_LIMITS_VERIFIED=false
# Persistent worker only. Sandbox sender is for isolated acceptance, not public signups.
AUTH_EMAIL_ENABLED=false
RESEND_API_KEY=
# Sender on the verified Resend domain. Verify real inbox delivery before enabling email sign-in.
AUTH_EMAIL_FROM="Cafe Loyalty <no-reply@loyalty-cafe.shop>"
# Operator tooling only; never configure in web or worker deployments.
SUPABASE_ACCESS_TOKEN=
EXPORT_PROCESSING_ENABLED=false
PRIVACY_PROCESSING_ENABLED=false
# Persistent monitor: an actual private HTTPS webhook destination. Missing means unconfigured.
MONITOR_WEBHOOK_URL=
# Discord incoming webhook URLs are detected automatically; no separate token needed.
# Generic HTTPS webhooks continue to receive JSON and may use this bearer token.
MONITOR_WEBHOOK_TOKEN=
# Separate Vercel monitor only. Login can execute fixed health checks, not worker jobs.
MONITOR_DATABASE_URL=
MONITOR_APP_ORIGIN=https://loyalty-saas-three.vercel.app
MONITOR_ENABLED=false
# Operator tooling only; the monitor deployment uses its distinct CRON_SECRET.
MONITOR_CONTROL_ORIGIN=
MONITOR_CRON_SECRET=

# Vercel worker: enable only in the intended deployed environment. No migration key.
VERCEL_WORKER_ENABLED=false
# Random >=32-character bearer secret for Vercel Cron and worker control.
CRON_SECRET=
# Required only if live FCM is enabled on Vercel; private service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
